# --- secrets: never commit any of these ------------------------------
.env
.env.*
!.env.example
credentials.json
client_secret*.json
google_credentials.json
token.json
token.pickle
*refresh_token*
service-account*.json
*-service-account.json

# One-time client authorization package (contains client_secret.json).
# Built locally, handed to the client directly - never through git.
client_setup/
David_Google_Setup.zip

# Written by scripts/google_auth_setup.py for a safe Notepad copy of the
# five GitHub secrets; deleted after setup. Never commit it, anywhere.
github_secrets.txt

# --- local machine helpers (CA bundles, scratch) ---------------------
.local/

# --- python ----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- generated artefacts ---------------------------------------------
logs/*.log
logs/*.log.*

outputs/*
!outputs/.gitkeep

# The production model is persisted to Google Drive, not to git.
# See README "Model persistence" - GitHub runners are ephemeral.
models/*
!models/.gitkeep

