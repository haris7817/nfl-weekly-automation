# Copy to `.env` for local runs. NEVER commit the filled-in file.
# In the cloud these are GitHub Actions repository secrets, not a file.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)

# ---------------------------------------------------------------------
# Analytics settings
# ---------------------------------------------------------------------
# Trailing games used for EPA and the fair-line feature. The client's
# agreed default is 5; changing it is a modelling change, and the stored
# model records the value it was trained with so the two cannot diverge.
TRAILING_GAMES_N=5

# Minimum prior games before a team can be projected at all.
MIN_TRAILING_GAMES=3

# Oldest season included when the model is retrained.
TRAINING_START_SEASON=2021

# Retrain every N weeks (also retrains when no usable model exists,
# when a new season starts, or when --retrain is passed).
RETRAIN_EVERY_WEEKS=4

# Friday runs happen after Thursday Night Football. Leave false so a
# finished game is never presented as an upcoming projection. Set true
# (or pass --include-completed) to reproduce a historical week.
INCLUDE_COMPLETED_WEEK_GAMES=false

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Google resources
# ---------------------------------------------------------------------
# Both IDs are produced by scripts/google_auth_setup.py. Because the app
# uses the narrow drive.file scope, it can only touch files it created
# itself - so let the setup helper create the folder and the Sheet.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------
# Google OAuth credentials  ***SECRET - never commit these***
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: override the OAuth scopes. The production default is exactly
#   https://www.googleapis.com/auth/drive.file
# (non-sensitive; covers the Drive archive AND every Sheets operation on
# the spreadsheet the app itself created - no separate Sheets scope is
# needed). Only widen this to .../auth/drive (a RESTRICTED scope, for
# troubleshooting, not production) if the client insists on a Drive folder
# created by hand in the browser - hand-made files are invisible to
# drive.file, which is why scripts/google_auth_setup.py creates the folder
# and the Sheet through the API.
# GOOGLE_SCOPES=

# ---------------------------------------------------------------------
# Local-machine options
# ---------------------------------------------------------------------
# Cache nflverse downloads on disk instead of in memory. Strongly
# recommended locally; leave unset on the ephemeral cloud runner.
# NFLREADPY_CACHE_MODE=filesystem

# Verify TLS against the operating system certificate store. Defaults to
# true on Windows, which fixes CERTIFICATE_VERIFY_FAILED on machines
# where antivirus (AVG/Avast/Kaspersky) or a corporate proxy inspects
# HTTPS. Set to false to force the bundled certifi list instead.
# USE_SYSTEM_CERT_STORE=true
